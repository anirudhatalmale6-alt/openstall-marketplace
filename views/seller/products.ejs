<%- include('../partials/head') %>
<main>
  <div class="wrap applayout">
    <%- include('nav') %>
    <div>
      <div class="pagehead spread">
        <div><h1>Products</h1><p><%= products.length %> listings in <%= vendor.shop_name %>.</p></div>
        <a class="btn" href="/seller/products/new">Add a product</a>
      </div>

      <% if (!products.length) { %>
        <div class="panel empty"><h2>No products yet</h2>
          <p>Add your first listing - it takes about a minute.</p>
          <a class="btn" href="/seller/products/new">Add a product</a></div>
      <% } else { %>
        <div class="tablewrap">
          <table class="data">
            <thead><tr><th></th><th>Product</th><th>Category</th><th class="num">Price</th><th class="num">Stock</th>
              <th class="num">Sold</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% products.forEach(function (p) { %>
                <tr>
                  <td><img src="<%= imgFor(p) %>" alt="" width="40" height="40"
                           style="width:40px;height:40px;border-radius:7px;object-fit:cover"></td>
                  <td><strong><%= p.title %></strong></td>
                  <td class="small muted"><%= p.category || '-' %></td>
                  <td class="num mono"><%= money(p.price_cents) %></td>
                  <td class="num"><%= p.stock %></td>
                  <td class="num"><%= p.sold %></td>
                  <td><span class="badge <%= p.status === 'active' ? 'green' : 'grey' %>"><%= p.status === 'active' ? 'listed' : 'draft' %></span></td>
                  <td class="right">
                    <div class="row" style="justify-content:flex-end;gap:.3rem">
                      <a class="btn ghost sm" href="/seller/products/<%= p.id %>/edit">Edit</a>
                      <form method="post" action="/seller/products/<%= p.id %>/delete"
                            onsubmit="return confirm('Delete &quot;<%= p.title %>&quot;?')">
                        <button class="btn danger sm" type="submit">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
