<%- include('partials/head') %>
<main>
  <div class="wrap">
    <div class="pagehead spread">
      <div>
        <h1>Order #<%= order.id %></h1>
        <p>Placed <%= order.placed_at %> &middot;
          <span class="badge <%= statusClass(order.status) %>"><%= statusLabel(order.status) %></span>
        </p>
      </div>
      <a class="btn ghost" href="/account/orders">All your orders</a>
    </div>

    <div class="cartlayout">
      <div class="panel">
        <h3>Items</h3>
        <% items.forEach(function (it) { %>
          <div class="cartline" style="grid-template-columns:minmax(0,1fr) auto">
            <div>
              <div class="tiny muted" style="text-transform:uppercase;letter-spacing:.05em">
                <a href="/shop/<%= it.shop_slug %>" style="color:inherit"><%= it.shop_name %></a>
              </div>
              <strong><%= it.title %></strong>
              <div class="small muted"><%= it.qty %> &times; <%= money(it.unit_price_cents) %></div>
            </div>
            <div class="right">
              <div class="mono" style="font-weight:600"><%= money(it.unit_price_cents * it.qty) %></div>
              <span class="badge <%= statusClass(it.fulfil_status) %>"><%= statusLabel(it.fulfil_status) %></span>
            </div>
          </div>
        <% }); %>

        <%
          const unpaid    = order.status === 'awaiting_payment';
          const cancelled = order.status === 'cancelled';
          const settled   = !unpaid && !cancelled;
          const dispatched = order.status === 'shipped' || order.status === 'delivered';
        %>
        <div class="steps">
          <div class="step <%= settled ? 'done' : '' %>"><div class="t">1. Payment</div>
            <div class="v"><%= cancelled ? 'Not taken' : unpaid ? 'Waiting' : 'Accepted' %></div></div>
          <div class="step <%= dispatched ? 'done' : '' %>"><div class="t">2. Dispatch</div>
            <div class="v"><%= cancelled ? '-' : dispatched ? 'Shipped' : settled ? 'With the sellers' : 'Not started' %></div></div>
          <div class="step <%= order.status === 'delivered' ? 'done' : '' %>"><div class="t">3. Delivery</div>
            <div class="v"><%= cancelled ? '-' : order.status === 'delivered' ? 'Delivered' : 'On the way' %></div></div>
        </div>

        <% if (unpaid) { %>
          <div class="flash info" style="max-width:none;margin:1rem 0 0">
            We are still waiting on your payment provider to confirm this one. Nothing ships until it does.
          </div>
        <% } else if (cancelled) { %>
          <div class="flash warn" style="max-width:none;margin:1rem 0 0">
            This order was cancelled and no money was taken. The items went back into stock.
          </div>
        <% } %>
      </div>

      <aside class="panel">
        <h3>Delivering to</h3>
        <p class="small" style="margin:0">
          <%= order.ship_name %><br>
          <%= order.ship_address %><br>
          <%= order.ship_city %>, <%= order.ship_zip %><br>
          <%= order.ship_country %>
        </p>
        <div class="totals" style="margin-top:1.2rem">
          <div class="line grand"><span>Paid</span><span class="mono"><%= money(order.total_cents) %></span></div>
        </div>
        <a class="btn ghost block" href="/browse" style="margin-top:1rem">Keep shopping</a>
      </aside>
    </div>
  </div>
</main>
<%- include('partials/foot') %>
