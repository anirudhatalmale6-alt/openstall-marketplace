<%- include('../partials/head') %>
<main>
  <div class="wrap applayout">
    <%- include('nav') %>
    <div>
      <div class="pagehead"><h1>Orders</h1><p><%= orders.length %> orders across the marketplace.</p></div>

      <div class="tablewrap">
        <table class="data" style="min-width:800px">
          <thead><tr><th>Order</th><th>Buyer</th><th class="num">Items</th><th class="num">Total</th>
            <th class="num">Commission</th><th>Status</th><th>Set status</th><th></th></tr></thead>
          <tbody>
            <% orders.forEach(function (o) { %>
              <tr>
                <td>#<%= o.id %><div class="tiny muted"><%= o.placed_at %></div></td>
                <td class="small"><%= o.buyer %><div class="tiny muted"><%= o.email %></div></td>
                <td class="num"><%= o.items %></td>
                <td class="num mono"><%= money(o.total_cents) %></td>
                <td class="num mono"><%= money(o.commission) %></td>
                <td><span class="badge <%= statusClass(o.status) %>"><%= statusLabel(o.status) %></span></td>
                <td>
                  <form method="post" action="/admin/orders/<%= o.id %>/status" class="row" style="gap:.3rem">
                    <select name="status" style="width:auto;font-size:.82rem;padding:5px 8px">
                      <option value="" selected>- <%= statusLabel(o.status) %> -</option>
                      <% const choices = o.status === 'awaiting_payment' ? ['cancelled']
                                                                        : ['shipped','delivered','cancelled']; %>
                      <% choices.forEach(function (s) { %>
                        <option value="<%= s %>"><%= s %></option>
                      <% }); %>
                    </select>
                    <button class="btn ghost sm" type="submit">Save</button>
                  </form>
                </td>
                <td class="right"><a class="btn ghost sm" href="/order/<%= o.id %>">View</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
