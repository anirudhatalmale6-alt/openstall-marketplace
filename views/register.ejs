<%- include('partials/head') %>
<main>
  <div class="wrap authwrap">
    <div class="pagehead center"><h1>Create an account</h1><p>You can open a shop later from the same account.</p></div>
    <div class="panel">
      <% if (locals.errors && errors.length) { %>
        <ul class="errors"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul>
      <% } %>
      <form method="post" action="/register">
        <label class="field"><span>Your name</span>
          <input type="text" name="name" value="<%= form.name || '' %>" required autofocus></label>
        <label class="field"><span>Email</span>
          <input type="email" name="email" value="<%= form.email || '' %>" required></label>
        <label class="field"><span>Password</span>
          <input type="password" name="password" minlength="8" required>
          <span class="tiny muted">At least 8 characters.</span></label>
        <button class="btn block" type="submit">Create account</button>
      </form>
      <p class="small center" style="margin:1rem 0 0">Already registered? <a href="/login">Sign in</a></p>
    </div>
  </div>
</main>
<%- include('partials/foot') %>
