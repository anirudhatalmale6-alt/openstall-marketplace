<%- include('partials/head') %>
<main>
  <div class="wrap">
    <nav class="breadcrumb">
      <a href="/">Home</a><span>/</span>
      <% if (product.cat_slug) { %><a href="/browse?cat=<%= product.cat_slug %>"><%= product.category %></a><span>/</span><% } %>
      <%= product.title %>
    </nav>

    <div class="pdetail">
      <div class="gallery">
        <img src="<%= imgFor(product) %>" alt="<%= product.title %>" width="600" height="600">
      </div>

      <div class="stack">
        <div>
          <div class="tiny muted" style="letter-spacing:.06em;text-transform:uppercase">
            <a href="/shop/<%= product.shop_slug %>" style="color:inherit"><%= product.shop_name %></a>
          </div>
          <h1 style="margin:.2rem 0 .4rem"><%= product.title %></h1>
          <div class="price-big mono"><%= money(product.price_cents) %></div>
        </div>

        <p class="desc"><%= product.description %></p>

        <div class="row small muted">
          <% if (product.stock > 5) { %><span class="badge green">In stock</span>
          <% } else if (product.stock > 0) { %><span class="badge amber">Only <%= product.stock %> left</span>
          <% } else { %><span class="badge red">Sold out</span><% } %>
          <% if (sold > 0) { %><span><%= sold %> sold</span><% } %>
          <% if (product.category) { %><span>&middot; <%= product.category %></span><% } %>
        </div>

        <% if (product.stock > 0) { %>
          <form method="post" action="/cart/add" class="row" style="margin-top:.4rem">
            <input type="hidden" name="product_id" value="<%= product.id %>">
            <input type="hidden" name="redirect" value="/cart">
            <div class="qty">
              <label class="small muted" for="qty">Qty</label>
              <input type="number" id="qty" name="qty" value="1" min="1" max="<%= product.stock %>">
            </div>
            <button class="btn" type="submit">Add to basket</button>
          </form>
        <% } else { %>
          <button class="btn" disabled>Sold out</button>
        <% } %>

        <div class="vendorbox">
          <div class="avatar" style="background:<%= product.accent %>;width:46px;height:46px;border-radius:12px;display:grid;place-items:center;color:#fff;font-family:Georgia,serif;font-weight:600">
            <%= product.shop_name.slice(0,1) %>
          </div>
          <div class="grow">
            <strong><%= product.shop_name %></strong>
            <div class="small muted"><%= product.tagline %></div>
          </div>
          <a class="btn ghost sm" href="/shop/<%= product.shop_slug %>">Visit shop</a>
        </div>

        <p class="tiny muted">Ships from the seller within two working days. Free delivery on orders over $75.</p>
      </div>
    </div>

    <% if (more.length) { %>
      <section class="section">
        <h2>More from <%= product.shop_name %></h2>
        <div class="pgrid">
          <% more.forEach(function (p) { %><%- include('partials/pcard', { p: p }) %><% }); %>
        </div>
      </section>
    <% } %>
  </div>
</main>
<%- include('partials/foot') %>
